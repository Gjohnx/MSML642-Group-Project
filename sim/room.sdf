    <model name="robot">
      <pose>0 0 0.005 0 0 0</pose>
      <link name="base">
        <pose>0 0 0.135 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.012</ixx><iyy>0.019</iyy><izz>0.027</izz></inertia>
        </inertial>
        <collision name="body"><geometry><box><size>0.32 0.24 0.12</size></box></geometry></collision>
        <visual name="body_visual">
          <geometry><box><size>0.32 0.24 0.12</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
        <collision name="caster">
          <pose>-0.12 0 -0.105 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <surface><friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction></surface>
        </collision>
        <sensor name="contact" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>body</collision></contact>
        </sensor>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.12 0 0.09 0 0 0</pose>
          <topic>/robot/scan</topic>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <lidar>
            <scan><horizontal>
              <samples>181</samples><resolution>1</resolution>
              <min_angle>-1.570796</min_angle><max_angle>1.570796</max_angle>
            </horizontal></scan>
            <range><min>0.05</min><max>6.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0.04 0.145 0.08 1.570796 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.00035</ixx><iyy>0.00035</iyy><izz>0.00064</izz></inertia>
        </inertial>
        <collision name="tire">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="tire_visual">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </visual>
      </link>
      <joint name="left_joint" type="revolute">
        <parent>base</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>

      <link name="right_wheel">
        <pose>0.04 -0.145 0.08 1.570796 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.00035</ixx><iyy>0.00035</iyy><izz>0.00064</izz></inertia>
        </inertial>
        <collision name="tire">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="tire_visual">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </visual>
      </link>
      <joint name="right_joint" type="revolute">
        <parent>base</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint>
        <right_joint>right_joint</right_joint>
        <wheel_separation>0.29</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>/robot/cmd_vel</topic>
        <odom_topic>/robot/odom</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>robot</robot_base_frame>
        <odom_topic>/robot/ground_truth</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </model>
